<?xml version="1.0" encoding="utf-8"?>
<!--
  SECURITY_PRIVACY.md §6 / P-4: the service is scoped to the official ChatGPT app by
  `packageNames`, so events from any other app are never delivered to us. Node
  traversal additionally re-checks the root window's package before reading anything.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames="com.openai.chatgpt" />
